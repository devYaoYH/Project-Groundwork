# Copy to `.env` at the repo root and fill in what you need.
#
#     cp .env.example .env
#
# `.env` is gitignored. Every game's run.py loads it automatically, so keys and
# endpoints stay out of the experiment YAML you commit.

# ---------------------------------------------------------------------------
# A) Model API keys
# ---------------------------------------------------------------------------
# Only the providers you actually use need a key. `--dry-run` tells you which
# ones an experiment requires before it spends anything.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# Vertex AI models authenticate with Application Default Credentials instead of
# a key: run `gcloud auth application-default login`, then set the project.
# GOOGLE_CLOUD_PROJECT=
# A2A_VERTEX_GEMINI_PROJECT=
# A2A_VERTEX_GEMINI_ADC_FILE=
# A2A_VERTEX_ANTHROPIC_PROJECT=
# A2A_VERTEX_ANTHROPIC_ADC_FILE=
# A2A_VERTEX_MAAS_PROJECT=
# A2A_VERTEX_MAAS_ADC_FILE=

# ---------------------------------------------------------------------------
# B) Trace sink
# ---------------------------------------------------------------------------
# Where experiment traces land. Referenced from experiments/storage.yaml, so
# the committed YAML names a sink and this file supplies the account details.

# --- sqlite (default; no external service) ---
A2A_TRACE_DB=./results/a2a_traces.db

# --- s3 ---
# A2A_TRACE_BUCKET=
# A2A_TRACE_PREFIX=traces
# AWS_PROFILE=

# --- firestore ---
# A2A_FIRESTORE_COLLECTION=game_traces

# Overrides the sink named by any experiment, for one-off runs.
# A2A_STORAGE_BACKEND=sqlite

# ---------------------------------------------------------------------------
# C) Tracing (optional)
# ---------------------------------------------------------------------------
# Setting both keys wires OpenTelemetry export to Langfuse automatically.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Local research traces include OTel prompt/completion content by default.
# Set false in a private deployment that needs a reduced OTel logging surface.
# A2A_CAPTURE_CONTENT=false
