              {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reasoning Tokens"
          },
          "total_tokens": {
            "default": 0,
            "maximum": 1000000000,
            "minimum": 0,
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "title": "TokenUsage",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "reflection": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
