  "ToolOutcome": {
    "additionalProperties": false,
    "properties": {
      "code": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Code"
      },
      "data": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "items": {},
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Data"
      },
      "reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reason"
      },
      "resolves": {
        "enum": [
          "read_only",
          "immediate",
          "end_of_turn",
          "end_of_phase"
        ],
        "title": "Resolves",
        "type": "string"
      },
      "status": {
        "enum": [
          "accepted",
          "rejected",
          "ok"
        ],
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "status",
      "resolves"
    ],
    "title": "ToolOutcome",
    "type": "object"
  },
