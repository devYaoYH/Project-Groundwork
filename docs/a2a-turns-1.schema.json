                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextPart"
                },
                {
                  "$ref": "#/$defs/ImagePart"
                }
              ]
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "title": "Content"
      },
