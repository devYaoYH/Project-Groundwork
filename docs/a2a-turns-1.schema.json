  "JoinRequest": {
    "additionalProperties": false,
    "properties": {
      "agent_info": {
        "additionalProperties": {
          "type": "string"
        },
        "maxProperties": 16,
        "title": "Agent Info",
        "type": "object"
      },
      "callback_url": {
        "maxLength": 2048,
        "title": "Callback Url",
        "type": "string"
