FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/workspace
WORKDIR /workspace
COPY . /workspace
RUN python -m pip install --no-cache-dir -e 'a2a-engine[runner]' -e a2a-judge -e expt-runner \
    -e games/buyer-seller -e games/calendar -e games/negotiation -e games/word-guess
