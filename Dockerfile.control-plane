FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim AS catalog
COPY games /source-games
COPY experiments /source-experiments
COPY scripts/build_control_catalog.py /build_control_catalog.py
RUN python /build_control_catalog.py

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/workspace
WORKDIR /workspace
COPY a2a-engine /workspace/a2a-engine
COPY local_stack /workspace/local_stack
COPY --from=catalog /catalog /workspace
COPY --from=web /web/out /opt/groundwork-web
RUN python -m pip install --no-cache-dir -e a2a-engine
