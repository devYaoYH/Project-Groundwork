FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/workspace PLATFORM_STATIC_DIR=/opt/groundwork-web
WORKDIR /workspace
COPY . /workspace
COPY --from=web /web/out /opt/groundwork-web
RUN python scripts/install_workspace.py && python -m pip install --no-cache-dir -r requirements-platform.txt
CMD ["python", "-m", "uvicorn", "cloud_platform.api:app", "--host", "0.0.0.0", "--port", "8080"]
